{
  "name": "@mssql-connectors/dab-js",
  "version": "0.2.0",
  "description": "A small fluent JavaScript client for Microsoft Data API builder.",
  "keywords": [
    "azure",
    "data-api-builder",
    "dab",
    "fluent-api",
    "sql"
  ],
  "homepage": "https://github.com/mssql-connectors/dab-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mssql-connectors/dab-js.git",
    "directory": "sdks/javascript"
  },
  "bugs": {
    "url": "https://github.com/mssql-connectors/dab-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/*.test.js",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov node --test test/*.test.js",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "check:package": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "c8": {
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "branches": 60,
    "functions": 70
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "c8": "^10.1.3",
    "typescript": "^5.0.0"
  }
}
